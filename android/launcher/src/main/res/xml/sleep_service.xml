<?xml version="1.0" encoding="utf-8"?>
<!-- «مؤقت النوم»: asks for no events and no window content (canRequestFilterKeyEvents only lets the opt-in settings-key option ask
     for the keys at run time, see SleepService.java; the flag itself is not set here, so by default no key is seen); the service exists only to be allowed to turn the screen off
     (GLOBAL_ACTION_LOCK_SCREEN, see SleepService.java) -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/sleep_service_desc"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:canRequestFilterKeyEvents="true" />
